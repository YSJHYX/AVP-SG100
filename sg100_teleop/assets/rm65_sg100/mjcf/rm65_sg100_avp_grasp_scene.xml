<?xml version="1.0" encoding="utf-8"?>

<mujoco model="RM65-SG100-avp-grasp-scene">

  <!--
    AVP teleop + grasp scene.

    Derived from rm65_sg100_grasp_scene.xml. Differences:
      * includes rm65_sg100_avp_grasp_robot.xml (collision robot with the
        palm backstop and link-2 capsules baked in);
      * gravity is ON (0 0 -9.81) so the water bottle rests on the table.

    When this scene is driven by run_avp_arm_hand_sim.py, the arm needs a
    one-line gravity-compensation feedforward in the physics loop (see plan);
    this XML itself is gravity-correct and validated standalone.
  -->

  <!--
    Main-file option wins over the included robot's option, so this sets
    gravity for the whole model.
  -->
  <option
    timestep="0.002"
    integrator="implicitfast"
    gravity="0 0 -9.81"
    noslip_iterations="3"
  />
  <compiler angle="radian" />

  <!-- Allow the recording renderer's default 1280x720 offscreen target. -->
  <visual>
    <global offwidth="1280" offheight="720" />
    <!-- Headlight disabled: it was the dominant over-exposure source on
         white RM65/SG100 surfaces.  Keeping it off also makes illumination
         identical between cameras instead of view-dependent. -->
    <headlight active="0" />
  </visual>

  <include file="rm65_sg100_avp_grasp_robot.xml"/>
  <include file="rm65_sg100_avp_grasp_objects.xml"/>

  <!--
    Scene-level workspace reference markers.

    These are visualization/debug sites only.
    They do not participate in collision or dynamics.
  -->
  <worldbody>

    <!--
      Visual-only neutral charcoal workstation floor.  It supplies a stable,
      low-information background where a camera sees past the table, while
      remaining deliberately much darker than the matte neutral tabletop.
      No collision, no dynamics.
    -->
    <geom
      name="workstation_floor_visual"
      type="plane"
      size="0 0 0.001"
      pos="0.30 0.15 -0.041"
      rgba="0.075 0.080 0.085 1"
      contype="0"
      conaffinity="0"
      group="1"
    />

    <!--
      Fixed VLA head/eye camera on the RM65 side of the workstation.

      v7 deliberately restores the frozen v4 base-side, over-the-arm
      geometry.  Its target is the recorded active interaction centroid,
      not the table centre or RM65 pedestal.  The lower table corners and
      pedestal may remain outside the image: pixel density is reserved for
      task objects, SG100, wrist/forearm, and the manipulation path.
      Camera and target share world Y, so world-up look-at construction gives
      zero table roll.  World-fixed, no physical effect.
    -->
    <camera
      name="workstation_front"
      mode="fixed"
      pos="-0.050000000 -0.073461236 0.900000000"
      xyaxes="0.000000000 -1.000000000 0.000000000 0.808212783 0.000000000 0.588890565"
      fovy="50"
    />

    <!--
      Single soft key light for deterministic offscreen recording.  Shadow
      casting stays disabled because the original SG100 CAD export contains
      thousands of adjacent shells: MuJoCo shadow-map self-intersection on
      those shells creates jagged false "missing triangle" bands even though
      the visual surface is complete.  A modest ambient component on this
      same light retains readable shape without adding another light source.
    -->
    <light
      name="workstation_key"
      directional="true"
      pos="-0.20 -0.50 2.20"
      dir="0.26372844 0.33980396 -0.90276275"
      ambient="0.35 0.35 0.35"
      diffuse="0.65 0.65 0.65"
      specular="0.10 0.10 0.10"
      castshadow="false"
    />

    <!-- Q_TELEOP_READY TCP position -->
    <site
      name="workspace_ready"
      type="sphere"
      pos="0.25048434 0.11727796 0.62550799"
      size="0.006"
      rgba="0 1 0 1"
    />

    <!-- radial = +60 mm -->
    <site
      name="workspace_outward_60"
      type="sphere"
      pos="0.30482326 0.14271970 0.62550799"
      size="0.005"
      rgba="1 0 0 1"
    />

    <!-- radial = -60 mm -->
    <site
      name="workspace_inward_60"
      type="sphere"
      pos="0.19614543 0.09183622 0.62550799"
      size="0.005"
      rgba="1 0 0 1"
    />

    <!-- lateral = +160 mm = LEFT -->
    <site
      name="workspace_left_160"
      type="sphere"
      pos="0.18263970 0.26218174 0.62550799"
      size="0.005"
      rgba="0 0 1 1"
    />

    <!-- lateral = -140 mm = RIGHT -->
    <site
      name="workspace_right_140"
      type="sphere"
      pos="0.30984840 -0.00951285 0.62550799"
      size="0.005"
      rgba="0 0 1 1"
    />

        <!-- ======================================================
         Big table = robot mount + workspace surface

         The robot base_link sits ON this table: the tabletop's top
         face is exactly at z = 0, matching the base STL's bottom
         (z = 0), and the water bottle rests on the same surface.

         Axes are aligned with the world (no yaw).

         Dimensions:
           depth     = 900 mm   (x: -0.150 .. +0.750)
           width     = 1000 mm  (y: -0.350 .. +0.650)
           thickness = 40 mm

         Collision (same masks as the old raised workspace table):
           bottle <-> table ON
           finger <-> table OFF (by intent; see validate script note)
           arm    <-> table ON
         ====================================================== -->

    <body
      name="grasp_table"
      pos="0.30 0.15 -0.02"
    >
      <geom
        name="grasp_table_collision"
        type="box"
        size="0.450 0.500 0.020"
        rgba="0.42 0.43 0.44 1"
        contype="4"
        conaffinity="3"
        friction="0.8 0.005 0.0001"
        solref="0.005 1"
      />
    </body>

        <!-- ======================================================
         Upright primitive water bottle

         Height   = 220 mm
         Diameter = 40 mm

         Initial placement:
           105 mm OUTWARD from READY grasp reference.
           Bottle bottom (z 0.00000) sits exactly on the tabletop
           (z = 0), i.e. directly on the robot's mount table.

         Free joint makes bottle a dynamic 6-DoF rigid body.

         Collision:
           finger <-> bottle ON
           bottle <-> table ON
         ====================================================== -->

    <body
      name="water_bottle"
      pos="0.46101150 0.29368833 0.11000000"
    >
      <freejoint
        name="water_bottle_free"
      />

      <geom
        name="water_bottle_collision"
        type="cylinder"
        size="0.020 0.110"
        mass="0.500"
        rgba="0.2 0.6 1.0 0.75"
        contype="2"
        conaffinity="1"
        friction="1.5 0.01 0.0001"
        condim="4"
        solref="0.005 1"
      />

      <!--
          Intended side-grasp height.

          World grasp-reference Z:
            0.14944829

          Bottle center Z:
            0.11000000

          Therefore local grasp Z:
            +0.03944829
      -->
      <site
        name="water_bottle_grasp_center"
        type="sphere"
        pos="0 0 0.03944829"
        size="0.006"
        rgba="1 0.4 0 1"
      />

      <!--
          80 mm vertical grasp-critical band.
      -->
      <site
        name="water_bottle_grasp_roi_low"
        type="sphere"
        pos="0 0 -0.00055171"
        size="0.004"
        rgba="1 1 0 1"
      />

      <site
        name="water_bottle_grasp_roi_high"
        type="sphere"
        pos="0 0 0.07944829"
        size="0.004"
        rgba="1 1 0 1"
      />

    </body>

  </worldbody>

</mujoco>
