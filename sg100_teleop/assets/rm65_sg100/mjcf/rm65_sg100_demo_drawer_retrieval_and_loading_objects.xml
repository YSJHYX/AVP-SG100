<?xml version="1.0" encoding="utf-8"?>

<mujoco model="RM65-SG100-demo-drawer-retrieval-and-loading-objects">

  <!--
    DEMO 02 task objects and fixtures - Drawer Retrieval & Tray Loading.

    Scanned-object provenance (see ../scanned_objects/THIRD_PARTY.md):
      * SNAIL_MEASURING_TAPE - Google Scanned Objects via
        kevinzakka/mujoco_scanned_objects, CC-BY 4.0.  Raw units are
        metres, mesh scale 1.0.  Visual mesh only; collision is one
        rounded-box primitive proxy.

    Scanned geometry (mesh local frame, metres):
      raw AABB  x -0.0311..0.0328, y -0.0973..0.0971, z 0..0.0657
      -> 64 x 195 x 66 mm rounded tape-measure body, lying flat as
         scanned, long axis +Y.  Grasp width 64 mm with generous
         finger clearance inside the drawer.

    Collision classes follow the frozen V8 convention (see DEMO 01
    objects header).  Cabinet, drawer and tray are fixture class
    (4/3); the tape is a free task object (2/11).  The drawer and
    tray are flat single bodies (no nested runtime bodies).

    Cabinet: open-top shop-cabinet unit, static, primitive panels.
      outer 250 (X) x 320 (Y) x 150 (Z) at (0.62, 0.18)
      - back panel, two side walls, base skirt; top stays open so
        the SG100 can descend into the drawer cavity and both V8
        observation cameras see the interior object.
    Drawer: single prismatic slide joint on -X (qpos = open depth,
      0 .. 0.15 m), damping 8, frictionloss 4 N -> closed stable,
      smooth pull, no spring-back, holds any opened position.
    Handle: horizontal bar capsule, length 140 mm, diameter 30 mm,
      48 mm clear of the drawer front, mounted low (bar centre
      z = 0.0415 world) so the frozen V8 grasp-ready hand pose clears it
      by ~18 mm - four-finger hook / wrap plus thumb closure
      without entering any narrow recess.
    Tray: open shallow industrial tray at (0.33, -0.22), generous
      target zone, no lid, no precision pocket.
  -->

  <asset>
    <texture type="2d" name="tape_tex"
             file="../scanned_objects/SNAIL_MEASURING_TAPE/texture.png" />
    <material name="tape_mat" texture="tape_tex"
              specular="0.4" shininess="0.3" />
    <mesh name="tape_mesh"
          file="../scanned_objects/SNAIL_MEASURING_TAPE/model.obj" />
  </asset>

  <worldbody>

    <!-- ======================================================
         Static cabinet: back + sides + base skirt, open top.
         ====================================================== -->
    <body name="drawer_cabinet" pos="0.62 0.18 0">
      <geom name="cabinet_base" type="box" pos="0 0 0.008"
            size="0.125 0.160 0.008" group="1"
            rgba="0.34 0.37 0.41 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="cabinet_back" type="box" pos="0.112 0 0.085"
            size="0.013 0.160 0.077" group="1"
            rgba="0.30 0.33 0.37 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="cabinet_side_pY" type="box" pos="0 0.152 0.085"
            size="0.112 0.008 0.077" group="1"
            rgba="0.30 0.33 0.37 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="cabinet_side_nY" type="box" pos="0 -0.152 0.085"
            size="0.112 0.008 0.077" group="1"
            rgba="0.30 0.33 0.37 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
    </body>

    <!-- ======================================================
         Sliding drawer: one body, one prismatic joint.  Closed
         pose qpos=0; body frame sits at the closed position.
         Bottom plate top face at z = 0.024.  Front face at
         local x = -0.110.
         ====================================================== -->
    <body name="demo_drawer" pos="0.62 0.18 0.0165">
      <joint name="demo_drawer_slide" type="slide" pos="0 0 0"
             axis="-1 0 0" range="0 0.150" damping="8"
             frictionloss="4" actuatorfrcrange="-80 80" />
      <inertial pos="-0.02 0 0.06" mass="1.20"
                diaginertia="0.020 0.015 0.028" />
      <!-- bottom plate -->
      <geom name="drawer_bottom" type="box" pos="0 0 0.011"
            size="0.098 0.140 0.011" group="1"
            rgba="0.55 0.52 0.46 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <!-- low side walls (45 mm) -->
      <geom name="drawer_side_pY" type="box" pos="0 0.133 0.0455"
            size="0.098 0.007 0.0235" group="1"
            rgba="0.50 0.47 0.42 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="drawer_side_nY" type="box" pos="0 -0.133 0.0455"
            size="0.098 0.007 0.0235" group="1"
            rgba="0.50 0.47 0.42 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="drawer_back" type="box" pos="0.085 0 0.0455"
            size="0.007 0.140 0.0235" group="1"
            rgba="0.50 0.47 0.42 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <!-- front face with recessed panel look -->
      <geom name="drawer_front" type="box" pos="-0.105 0 0.070"
            size="0.009 0.140 0.070" group="1"
            rgba="0.46 0.43 0.38 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <!-- bar handle: length 140 mm, d30, 48 mm clear of the front -->
      <geom name="drawer_handle" type="capsule"
            fromto="-0.162 -0.070 0.025  -0.162 0.070 0.025"
            size="0.015" group="1"
            rgba="0.20 0.21 0.23 1"
            contype="4" conaffinity="3"
            friction="1.2 0.01 0.0001" condim="4" solref="0.005 1" />
      <geom name="drawer_handle_post_pY" type="box"
            pos="-0.138 0.070 0.025" size="0.024 0.007 0.007"
            group="1" rgba="0.20 0.21 0.23 1"
            contype="4" conaffinity="3"
            friction="1.2 0.01 0.0001" condim="4" solref="0.005 1" />
      <geom name="drawer_handle_post_nY" type="box"
            pos="-0.138 -0.070 0.025" size="0.024 0.007 0.007"
            group="1" rgba="0.20 0.21 0.23 1"
            contype="4" conaffinity="3"
            friction="1.2 0.01 0.0001" condim="4" solref="0.005 1" />
    </body>

    <!-- ======================================================
         Drawer item: scanned tape measure, flat freejoint body.
         Lying flat as scanned (long axis +Y), sitting on the
         drawer bottom toward the front third of the cavity.
         ====================================================== -->
    <body name="demo_drawer_item" pos="0.60 0.18 0.039">
      <freejoint name="demo_drawer_item_free" />
      <inertial pos="0.001 0 0.033" mass="0.25"
                diaginertia="0.00045 0.0009 0.0006" />
      <geom name="drawer_item_visual" type="mesh" mesh="tape_mesh"
            material="tape_mat" mass="0" group="1"
            contype="0" conaffinity="0" />
      <geom name="drawer_item_collision" type="box"
            pos="0.001 0 0.033" size="0.032 0.097 0.033"
            group="3"
            contype="2" conaffinity="11"
            friction="1.5 0.01 0.0001" condim="4" solref="0.005 1" />
    </body>

    <!-- ======================================================
         Goal tray: open shallow industrial tray.  Target zone is
         the full inner cavity - generous, no precision pocket.
         ====================================================== -->
    <body name="goal_tray" pos="0.33 -0.22 0">
      <geom name="tray_bottom" type="box" pos="0 0 0.006"
            size="0.115 0.085 0.006" group="1"
            rgba="0.28 0.30 0.33 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="tray_wall_pX" type="box" pos="0.110 0 0.020"
            size="0.005 0.085 0.014" group="1"
            rgba="0.33 0.36 0.39 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="tray_wall_nX" type="box" pos="-0.110 0 0.020"
            size="0.005 0.085 0.014" group="1"
            rgba="0.33 0.36 0.39 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="tray_wall_pY" type="box" pos="0 0.080 0.020"
            size="0.105 0.005 0.014" group="1"
            rgba="0.33 0.36 0.39 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <geom name="tray_wall_nY" type="box" pos="0 -0.080 0.020"
            size="0.105 0.005 0.014" group="1"
            rgba="0.33 0.36 0.39 1"
            contype="4" conaffinity="3"
            friction="0.8 0.005 0.0001" condim="4" solref="0.005 1" />
      <!-- visual target marking only: no collision -->
      <geom name="tray_target_mark" type="plane"
            pos="0 0 0.0125" size="0.070 0.050 0.001" group="1"
            rgba="0.85 0.55 0.10 1"
            contype="0" conaffinity="0" />
    </body>

  </worldbody>

</mujoco>
