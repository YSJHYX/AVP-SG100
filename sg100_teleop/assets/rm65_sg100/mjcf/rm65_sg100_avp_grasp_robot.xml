    <mesh name="link_5" content_type="model/stl" file="../../RM65-B/meshes/link_5.STL" />
    <mesh name="link_6" content_type="model/stl" file="../../RM65-B/meshes/link_6.STL" />
    <!--
      SG100 render geometry uses the original CAD-resolution STL exports.
      The former meshes_mujoco copies were destructively simplified: several
      193,892-face links and the 481,705-face palm were capped at 80,000
      faces, lost 85-89% of their surface area, and acquired inconsistent
      winding.  That produced holes and disconnected triangular fragments in
      camera renders.  These meshes remain visual-only below; contact still
      comes exclusively from the existing palm box and finger capsules.
    -->
    <!-- The 481,705-face palm exceeds MuJoCo's 200k-face STL limit.  It is
         losslessly partitioned by connected CAD shells; no faces are
         decimated, duplicated, transformed, or used for contact. -->
    <mesh name="sg100_base_link_visual_part1" content_type="model/stl" file="../../sg100/meshes_visual/base_link_visual_part1.STL" />
    <mesh name="sg100_base_link_visual_part2" content_type="model/stl" file="../../sg100/meshes_visual/base_link_visual_part2.STL" />
    <mesh name="sg100_base_link_visual_part3" content_type="model/stl" file="../../sg100/meshes_visual/base_link_visual_part3.STL" />
