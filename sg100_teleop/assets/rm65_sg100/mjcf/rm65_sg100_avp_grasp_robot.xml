                  <!--
                    Palm backstop (baked from run_grasp_demo.py PALM_* defaults).
                    Same collision class as the finger capsules so it presses
                    the bottle into the closing fingers.

                    Friction pads: the real SG100 carries rubber/silicone
                    friction tape on the palm and finger contact faces.
                    All hand grip geoms use sliding mu = 1.2 (rubber pad on
                    dry PET/aluminum, typical 1.0-1.4) with priority = 1 so
                    the pad value wins contact mixing against every
                    counterpart regardless of the other geom's friction.
                    Torsional/rolling coefficients document intent for a
                    future condim >= 4 (unused at condim 3).
                  -->
                  <geom
                    name="palm_collision"
                    type="box"
                    pos="0 -0.03 0.05"
                    size="0.045 0.035 0.010"
                    quat="0.5 0.5 0.5 -0.5"
                    contype="1"
                    conaffinity="2"
                    friction="1.2 0.01 0.001"
                    priority="1"
                    group="3"
                    rgba="0 1 0 0"
                  />
                  <!--
                    Compact inward-looking wrist camera, based on the
                    reference robot's short camera bar immediately proximal
                    to the hand.  In the sg100_base_link frame the fingers
                    point +Z, the forearm points -Z, the palm face points -Y,
                    and +X is the thumb side.  The optical centre sits at the
                    thumb/palm-side wrist corner (0.108, -0.015, -0.050).
                    Relative to the v3 pose it extends 43 mm farther toward
                    +X/thumb and 20 mm toward +Z/fingers, producing a 12.0 cm
                    palm-origin radius.  This moves the wrist body away from
                    image centre without reverting to a long little-finger-
                    side outrigger.

                    The invisible wrist_camera_interaction_target explicitly
                    defines the local hand-object ROI at
                    (0.020, -0.045, 0.130): 13 cm forward along the fingers
                    and 4.5 cm into the palm/contact direction.  The local
                    view ray (-0.4344, -0.1481, +0.8885) points from the
                    optical centre to that target.  An 80 degree field of
                    view increases interaction-region pixel density while
                    retaining the inner palm, opposing thumb, curled finger
                    row, target object, and contact region.  xyaxes are
                    computed from that ray with +Z as preferred image-up.

                    The black box is the visible camera body.  The slightly
                    larger invisible box is its physical envelope.  Its
                    contact class (contype=1, conaffinity=6) collides with
                    both table geoms (4/3) and grasp objects (2/1), but not
                    with SG100 finger pads (1/2) or RM65 link geoms (8/4), so
                    the fixed wrist mount cannot create artificial self-
                    contacts.  mass=0 preserves the calibrated hand inertia;
                    the geom still participates fully in collision.
                  -->
