<mujoco model="RM65-SG100-avp-grasp-robot">
  <!--
    AVP teleop + grasp robot.

    Derived from rm65_sg100_grasp_robot.xml (same 17-DoF kinematic tree,
    same joint/actuator names and order so resolve_robot_layout still passes),
    with three additions baked in so the scene is usable via plain
    MjModel.from_xml_path (no MjSpec mutation needed):

      1. palm_collision  - palm backstop box on sg100_base_link
                           (values from run_grasp_demo.py PALM_* constants).
      2. *_link2_collision capsules on thumb_link2 / index_link2 /
         little_llink2 (middle_link2 already has one), mirroring the
         fingertip (*_link3) collision design.
      3. forcerange="-20 20" on the 11 hand position actuators, baking in
         the compliant FINGER_FORCE_N = 20.0 that run_grasp_demo.py sets
         in Python.
  -->
  <!--
    gravity matches rm65_sg100_avp_grasp_scene.xml on purpose: this file is
    purpose-built for that scene, so agreeing here removes any ambiguity
    about include-merge precedence for the singleton <option>.
  -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" />
  <compiler angle="radian" />
  <asset>
    <mesh name="base_link" content_type="model/stl" file="../../RM65-B/meshes/base_link.STL" />
    <mesh name="link_1" content_type="model/stl" file="../../RM65-B/meshes/link_1.STL" />
    <mesh name="link_2" content_type="model/stl" file="../../RM65-B/meshes/link_2.STL" />
    <mesh name="link_3" content_type="model/stl" file="../../RM65-B/meshes/link_3.STL" />
